<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct HTTP access to sensitive files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^artisan - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]

    # Handle direct asset requests
    RewriteCond %{REQUEST_URI} ^/(css|js|assets|vendor|favicon\.ico|robots\.txt) [NC]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Direct all other requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
